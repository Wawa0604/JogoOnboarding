  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fe0e7d499db71a24ca9347d7d2354a3c, type: 3}
  m_Name: Confidencialidade_Adaptabilidade
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  id: Confidencialidade_Adaptabilidade
  iconeAvatar: {fileID: 21300000, guid: 99a9e747aeae9f64a82a4f10bb73edbb, type: 3}
  lines:
  - characterName: Adaptabilidade
    text: "\"Ol\xE1! Eu sou a Adaptabilidade. Adoro ver nossa equipe resolvendo problemas
      de forma \xE1gil, pr\xE1tica e sem complexidade desnecess\xE1ria. E para proteger
      o que temos de mais valioso \u2014 a informa\xE7\xE3o \u2014, o CPQD criou
      um sistema super simples de classifica\xE7\xE3o de sigilo integrado ao Google
      Workspace!\""
  - characterName: Adaptabilidade
    text: "\"Nossos dados s\xE3o divididos em 4 n\xEDveis claros: o N\xEDvel 1 (Irrestrito),
      que s\xE3o informa\xE7\xF5es p\xFAblicas; o N\xEDvel 2 (Reservado), de interesse
      apenas interno; o N\xEDvel 3 (Confidencial), com dados cr\xEDticos nossos ou
      de clientes; e o N\xEDvel 4 (Secreto), focado em estrat\xE9gias de alt\xEDssimo
      impacto.\""
  - characterName: Adaptabilidade
    text: "\"Se dados dos n\xEDveis 2, 3 ou 4 vazarem, o CPQD perde vantagem competitiva
      e prejudica a confian\xE7a dos nossos clientes. Ent\xE3o, fa\xE7a a sua parte:
      use o compartilhamento do Google Drive com as permiss\xF5es corretas e nunca
      envie dados sigilosos por WhatsApp, Teams ou e-mails sem criptografia.\""
  - characterName: Adaptabilidade
    text: "\"E lembre-se: nada de conversar sobre projetos sens\xEDveis em restaurantes,
      \xF4nibus ou locais p\xFAblicos, combinado? Se tiver qualquer d\xFAvida sobre
      as nossas diretrizes, a \xEDntegra de todas as Pol\xEDticas de Seguran\xE7a
      est\xE1 dispon\xEDvel para consulta r\xE1pida no nosso Confluence!\""
  missaoParaConcluir: {fileID: 0}
  OnSequenceComplete:
    m_PersistentCalls:
      m_Calls: []
  quizParaIniciar: {fileID: 11400000, guid: a7ea838063adc3c47949f05a3ce72f24, type: 2}
