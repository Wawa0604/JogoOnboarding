  m_Script: {fileID: 11500000, guid: fe0e7d499db71a24ca9347d7d2354a3c, type: 3}
  m_Name: BYOD_Adaptabilidade
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  id: BYOD_Adaptabilidade
  iconeAvatar: {fileID: 21300000, guid: 99a9e747aeae9f64a82a4f10bb73edbb, type: 3}
  lines:
  - characterName: Adaptabilidade
    text: "\"Oi! A Adaptabilidade tem tudo a ver com flexibilidade t\xE1tica. E o
      mercado moderno trouxe uma facilidade incr\xEDvel: o BYOD (Bring Your Own Device),
      que permite o uso de dispositivos particulares para agilizar nosso dia a dia.\" "
  - characterName: Adaptabilidade
    text: "\"No CPQD, o BYOD \xE9 100% opcional e restrito estritamente ao ecossistema
      do Google Workspace, que opera de forma protegida em nuvem. \xC9 expressamente
      proibido baixar ou armazenar arquivos e dados confidenciais do CPQD direto
      na mem\xF3ria do seu celular ou tablet pessoal!\""
  - characterName: Adaptabilidade
    text: "\"Nunca salve suas senhas corporativas no navegador do seu aparelho pessoal.
      E caso o seu celular com acessos da empresa seja perdido ou roubado: fa\xE7a
      o Boletim de Ocorr\xEAncia, mude suas senhas imediatamente e alerte a TI atrav\xE9s
      do Helpdesk!\""
  missaoParaConcluir: {fileID: 0}
  OnSequenceComplete:
    m_PersistentCalls:
      m_Calls: []
  quizParaIniciar: {fileID: 11400000, guid: a8dfd5b9760c780489222bad4503d962, type: 2}
