%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fe0e7d499db71a24ca9347d7d2354a3c, type: 3}
  m_Name: "NuvemGoogleWorkspaceEseguran\xE7aFisica_Confianca"
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  id: "NuvemGoogleWorkspaceEseguran\xE7aFisica_Confianca"
  iconeAvatar: {fileID: 21300000, guid: 4423566198bb37f41bea6732751efc45, type: 3}
  lines:
  - characterName: "Confian\xE7a"
    text: "\"Eu, a Confian\xE7a, tenho como valor o Profissionalismo. Acredito na
      capacidade e na responsabilidade de cada um de n\xF3s para manter nossas ferramentas
      de trabalho seguras. Afinal, a seguran\xE7a digital n\xE3o \xE9 s\xF3 papel
      da TI: ela depende das nossas atitudes di\xE1rias!\""
  - characterName: "Confian\xE7a"
    text: "\"Por isso, guarde bem a nossa regra de ouro: aqui no CPQD, tudo vai para
      a nuvem! Adotamos o Google Workspace, ent\xE3o salve tudo no seu Google Drive
      corporativo. A TI n\xE3o faz backup dos discos r\xEDgidos locais (HD). Se sumir
      da sua m\xE1quina e n\xE3o estiver na nuvem, j\xE1 era!\""
  - characterName: "Confian\xE7a"
    text: "\"Ah, e cuidado com o 'f\xEDsico' tamb\xE9m, combinado? Evite quedas,
      calor extremo e aquele cafezinho esperto perto do teclado. Se o notebook for
      perdido ou roubado, avise a equipe de seguran\xE7a imediatamente para bloquear
      o acesso remoto e proteger nossos dados.\""
  - characterName: "Confian\xE7a"
    text: "\"Para fechar: o antiv\xEDrus Trend Micro Apex One j\xE1 vem ativo e as
      atualiza\xE7\xF5es do Windows rodam sozinhas. Mas fique de olho no navegador
      Google Chrome e outros apps, porque eles precisam que voc\xEA autorize a atualiza\xE7\xE3o
      manual constante!\""
  missaoParaConcluir: {fileID: 0}
  OnSequenceComplete:
    m_PersistentCalls:
      m_Calls: []
  quizParaIniciar: {fileID: 11400000, guid: f8dc9c64fb6d5444eb5a90bb7cc267c7, type: 2}
