  m_Script: {fileID: 11500000, guid: fe0e7d499db71a24ca9347d7d2354a3c, type: 3}
  m_Name: Intro_Colaboracao
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  id: boasvindas_colaboracao
  lines:
  - characterName: "Colabora\xE7\xE3o"
    text: "\u201CSeja muito bem-vindo(a) ao seu onboarding no CPQD!\L Preparamos
      uma verdadeira aventura pelo nosso campus para te ajudar a se localizar melhor
      entre os pr\xE9dios, conhecer mais sobre o CPQD e descobrir todas as informa\xE7\xF5es
      importantes para o seu dia a dia conosco.\u201D"
  - characterName: "Colabora\xE7\xE3o"
    text: "\"Eu sou a Colabora\xE7\xE3o, um do We Movers do CPQD, eu e meus irm\xE3os
      representamos os valores do CPQD. Eu trago comigo a intens\xE3o do CPQD de
      fazer e evolu\xEDr  juntos, criando valor para a organiza\xE7\xE3o, os clientes,
      os parceiros e a sociedade.\""
  - characterName: "Colabora\xE7\xE3o"
    text: "\u201CAntes de iniciarmos essa jornada, que tal personalizar seu avatar
      para deix\xE1-lo com a sua identidade?\L Vamos l\xE1?\u201D"
  missaoParaConcluir: {fileID: 0}
  OnSequenceComplete:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 0}
        m_TargetAssemblyTypeName: 
        m_MethodName: 
        m_Mode: 0
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: 
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 0
        m_CallState: 2
