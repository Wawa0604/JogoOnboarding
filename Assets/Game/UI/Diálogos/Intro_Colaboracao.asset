  m_Script: {fileID: 11500000, guid: fe0e7d499db71a24ca9347d7d2354a3c, type: 3}
  m_Name: Intro_Colaboracao
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  id: boasvindas_colaboracao
  iconeAvatar: {fileID: 21300000, guid: 48a831e952638f34d871cc6372d04656, type: 3}
  lines:
  - characterName: "Colabora\xE7\xE3o"
    text: "\u201CSeja muito bem-vindo(a) ao seu onboarding no CPQD! Preparamos uma
      verdadeira aventura pelo nosso campus para te ajudar a se localizar melhor
      entre os pr\xE9dios, conhecer mais sobre o CPQD e descobrir todas as informa\xE7\xF5es
      importantes para o seu dia a dia conosco.\u201D"
  - characterName: "Colabora\xE7\xE3o"
    text: "\"Eu sou a Colabora\xE7\xE3o, um dos We Movers do CPQD. Eu e meus irm\xE3os
      representamos os valores fundamentais da nossa institui\xE7\xE3o. E logo em
      seguida iremos nos apresentar.\u201D"
  - characterName: "Colabora\xE7\xE3o"
    text: "\u201CAntes de iniciarmos essa jornada, que tal personalizar seu avatar
      para deix\xE1-lo com o seu jeito de ser? Vamos l\xE1?\u201D"
  missaoParaConcluir: {fileID: 0}
  OnSequenceComplete:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 2757011758355549007, guid: 44be27dbc4941524ab0dd0ee7a390a20, type: 3}
