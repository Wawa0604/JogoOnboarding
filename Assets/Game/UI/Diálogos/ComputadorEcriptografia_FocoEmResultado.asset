%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fe0e7d499db71a24ca9347d7d2354a3c, type: 3}
  m_Name: ComputadorEcriptografia_FocoEmResultado
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  id: ComputadorEcriptografia_FocoEmResultado
  iconeAvatar: {fileID: 21300000, guid: 008a1759b80d6004799b74f6e306fb50, type: 3}
  lines:
  - characterName: Foco em Resultado
    text: "\"Ol\xE1! Eu sou o Foco em Resultado. N\xF3s trabalhamos duro para criar
      solu\xE7\xF5es de ponta para o mercado e, para alcan\xE7armos nossas metas,
      precisamos do engajamento total de cada profissional. Ser engajado \xE9 ter
      proatividade e responsabilidade com a seguran\xE7a do nosso ecossistema!\""
  - characterName: Foco em Resultado
    text: "\"Esse compromisso ganha ainda mais peso no Trabalho Remoto. Quando estiver
      em home office ou em tr\xE2nsito, evite redes Wi-Fi p\xFAblicas ou sem senha
      (como as de cafeterias). Seus equipamentos corporativos s\xE3o exclusivos para
      o trabalho \u2014 nada de emprestar para a fam\xEDlia ou usar para fins pessoais!\""
  - characterName: Foco em Resultado
    text: "\"Adote a cultura da 'Mesa Limpa, Tela Limpa'. Vai levantar da cadeira
      para pegar uma \xE1gua ou ir ao banheiro? Bloqueie a tela do computador instantaneamente
      usando o atalho Windows + L (funciona tanto no Windows quanto no Linux). Ao
      final do expediente, guarde pap\xE9is importantes e desligue tudo.\""
  - characterName: Foco em Resultado
    text: "\"Por fim, fique atento aos sinais de incidentes de seguran\xE7a: sistemas
      muito lentos, falhas frequentes ou alertas estranhos do antiv\xEDrus. Suspeitou
      de malware ou perdeu um equipamento? Avise na hora o We Protect (weprotect@cpqd.com.br)
      e pare de usar a m\xE1quina infectada imediatamente.\""
  - characterName: Foco em Resultado
    text: "\"Para garantir que nossos dados trafeguem blindados, o CPQD exige o uso
      de t\xE9cnicas criptogr\xE1ficas aprovadas pela DGTIC, em conformidade com
      a norma NIST FIPS. Proteger nossa informa\xE7\xE3o garante a entrega dos melhores
      resultados com total seguran\xE7a!\""
  missaoParaConcluir: {fileID: 0}
  OnSequenceComplete:
    m_PersistentCalls:
      m_Calls: []
  quizParaIniciar: {fileID: 11400000, guid: a7d58341dcd1c3946a21f16791dac7ad, type: 2}
