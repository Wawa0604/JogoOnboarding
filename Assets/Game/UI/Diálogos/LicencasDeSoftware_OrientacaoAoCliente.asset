%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fe0e7d499db71a24ca9347d7d2354a3c, type: 3}
  m_Name: LicencasDeSoftware_OrientacaoAoCliente
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  id: LicencasDeSoftware_OrientacaoAoCliente
  iconeAvatar: {fileID: 21300000, guid: 4773a519812edad4dbac3536ff29a188, type: 3}
  lines:
  - characterName: "Orienta\xE7\xE3o ao Cliente"
    text: "\"Ol\xE1! Eu sou a Orienta\xE7\xE3o ao Cliente. N\xF3s prezamos muito
      pela nossa imagem e pela forma como o mercado nos percebe. Para manter nossa
      reputa\xE7\xE3o intacta, a integridade \xE9 fundamental \u2014 inclusive nos
      softwares que usamos!\""
  - characterName: "Orienta\xE7\xE3o ao Cliente"
    text: "\"Instalar programas pirateados ou 'crackeados' \xE9 considerado crime
      e abre as portas para malwares perigosos que podem paralisar a empresa. O CPQD
      tem toler\xE2ncia zero para pirataria. Lembre-se: licen\xE7as de uso pessoal
      tamb\xE9m n\xE3o s\xE3o permitidas nas m\xE1quinas corporativas.\""
  - characterName: "Orienta\xE7\xE3o ao Cliente"
    text: "\"Precisa de um programa novo para trabalhar? \xC9 super simples resolver
      isso com total seguran\xE7a! O primeiro passo \xE9 consultar a lista homologada
      no Confluence procurando por 'padr\xF5es de recursos de TIC' ou usando o atalho
      r\xE1pido: go.cpqd.com.br/padraosw.\""
  - characterName: "Orienta\xE7\xE3o ao Cliente"
    text: "\"Se o software j\xE1 estiver nessa lista e voc\xEA usa Windows, abra
      um chamado no Helpdesk (Jira) para liberarmos o seu perfil administrativo de
      instala\xE7\xE3o. Se usa Linux, pode instalar direto pelo reposit\xF3rio oficial
      da sua distribui\xE7\xE3o, desde que n\xE3o exija acesso de superusu\xE1rio
      (root).\""
  - characterName: "Orienta\xE7\xE3o ao Cliente"
    text: "\"E se o programa n\xE3o estiver na lista? Sem p\xE2nico! Basta abrir
      um chamado no Jira explicando a sua necessidade para que a equipe de TI fa\xE7a
      a valida\xE7\xE3o de seguran\xE7a. Ah, e lembre-se: licen\xE7as de uso pessoal
      n\xE3o entram nas m\xE1quinas da empresa, combinado?\""
  - characterName: "Orienta\xE7\xE3o ao Cliente"
    text: "\u201CPor falar em seguran\xE7a f\xEDsica da sua m\xE1quina, olho vivo
      nas portas USB! Dispositivos desconhecidos ou pessoais podem esconder c\xF3digos
      maliciosos perigosos. Que tal um teste r\xE1pido para ver se voc\xEA sabe o
      que pode e o que n\xE3o pode plugar por aqui?\u201D"
  missaoParaConcluir: {fileID: 0}
  OnSequenceComplete:
    m_PersistentCalls:
      m_Calls: []
  quizParaIniciar: {fileID: 11400000, guid: f8dc9c64fb6d5444eb5a90bb7cc267c7, type: 2}
