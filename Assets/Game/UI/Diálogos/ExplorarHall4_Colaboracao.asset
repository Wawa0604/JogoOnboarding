  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fe0e7d499db71a24ca9347d7d2354a3c, type: 3}
  m_Name: ExplorarHall4_Colaboracao
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  id: ExplorarHall4_Colaboracao
  iconeAvatar: {fileID: 21300000, guid: 48a831e952638f34d871cc6372d04656, type: 3}
  lines:
  - characterName: "Colabora\xE7\xE3o"
    text: "\u201COlha s\xF3! Voc\xEA encontrou o pr\xE9dio 4! Como o valor Colabora\xE7\xE3o,
      determino que no CPQD as \xE1reas n\xE3o se fecham em silos e trabalham como
      um grande equipe, voltada a procurar melhores solu\xE7\xF5es de trabalho.\u201D"
  - characterName: "Colabora\xE7\xE3o"
    text: "\u201CE aqui no pr\xE9dio 4, temos o atendimento presencial do helpdesk,
      para auxiliar com quaisquer quest\xF5es com os dispositivos do CPQD. As salas
      Outback de reuni\xE3o, nossa sala de descanso de uso comum e uma copa ampla 
      no segundo andar, com um mini mercado aut\xF4nomo\u201D"
  - characterName: "Colabora\xE7\xE3o"
    text: "\u201CPara garantir que nossa conviv\xEAncia por aqui seja nota dez, que
      tal um pequeno aquecimento sobre as rotinas do Pr\xE9dio 4? Vamos ver se voc\xEA
      descobre as melhores pr\xE1ticas!\u201D"
  missaoParaConcluir: {fileID: 0}
  OnSequenceComplete:
    m_PersistentCalls:
      m_Calls: []
  quizParaIniciar: {fileID: 11400000, guid: bb4715679e7f0e14cbd6464dcd876b02, type: 2}
